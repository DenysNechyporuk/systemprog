<Window x:Class="_02_TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_02_TaskManager"
        mc:Ignorable="d"
        Title="Task Manager" Height="450" Width="900">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Click="Refresh" Padding="10 5">Refresh</Button>
            <Separator />
            <TextBlock VerticalAlignment="Center" Margin="5 0">Interval (sec) ::</TextBlock>
            <RadioButton x:Name="intervalOne" Padding="5" VerticalContentAlignment="Center" Click="RadioButton_Click" GroupName="group1">1</RadioButton>
            <RadioButton x:Name="intervalTwo" Padding="5" VerticalContentAlignment="Center" Click="RadioButton_Click" GroupName="group1" IsChecked="True">2</RadioButton>
            <RadioButton x:Name="intervalFive" Padding="5" VerticalContentAlignment="Center" Click="RadioButton_Click" GroupName="group1">5</RadioButton>
            <Button Click="Stop_Timer" Padding="10 5">Stop</Button>
            <Separator />
            <Button Click="Kill_Process" Padding="10 5">Kill</Button>
            <Button Click="Show_Details" Padding="10 5">Show Details</Button>
            <Separator />
            <TextBox x:Name="processPathTextBox" Width="200" VerticalContentAlignment="Center" Text="calc.exe"></TextBox>
            <Button Click="Go_Click" Padding="10 5">Go</Button>
        </ToolBar>
        <TextBlock DockPanel.Dock="Bottom" x:Name="statusText" Padding="5"></TextBlock>
        <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process Name" Binding="{Binding ProcessName}" Width="200" />
                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80" />
                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="120" />
                <DataGridTextColumn Header="Total Processor Time" Binding="{Binding TotalProcessorTime}" Width="160" />
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="120" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>