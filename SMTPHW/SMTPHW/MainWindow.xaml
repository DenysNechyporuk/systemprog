<Window x:Class="SMTPHW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMTPHW"
        mc:Ignorable="d"
        Title="SMTP Mail Sender" Height="520" Width="600">
    <Grid>
        <StackPanel x:Name="loginPanel" Width="300" VerticalAlignment="Center">
            <TextBlock FontSize="22" FontWeight="Bold" TextAlignment="Center" Margin="0 0 0 15">Login</TextBlock>
            <Label>Mail service :</Label>
            <ComboBox x:Name="serviceComboBox" SelectedIndex="0">
                <ComboBoxItem>smtp.gmail.com</ComboBoxItem>
                <ComboBoxItem>smtp.mail.me.com</ComboBoxItem>
            </ComboBox>
            <Label>Email :</Label>
            <TextBox x:Name="emailTextBox" Padding="3"></TextBox>
            <Label>Password (app password) :</Label>
            <PasswordBox x:Name="passwordBox" Padding="3"></PasswordBox>
            <Button Margin="0 15 0 0" Padding="10" Background="#FF1398ED" Foreground="White" FontWeight="Bold" Click="LoginButton_Click">Login</Button>
        </StackPanel>

        <DockPanel x:Name="sendPanel" Visibility="Collapsed" Margin="10">
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Padding="10 3" Click="LogoutButton_Click">Logout</Button>
                <Label>From :</Label>
                <Label x:Name="fromLabel" FontWeight="Bold"></Label>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0 3">
                <Label Width="70">To :</Label>
                <TextBox x:Name="toTextBox" VerticalContentAlignment="Center"></TextBox>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0 3">
                <Label Width="70">Subject :</Label>
                <TextBox x:Name="subjectTextBox" VerticalContentAlignment="Center"></TextBox>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0 5 0 0">
                <CheckBox x:Name="importantCheckBox" VerticalAlignment="Center" FontWeight="Bold" Foreground="Red">Important</CheckBox>
                <Button DockPanel.Dock="Right" Padding="20 8" Background="#FF00AB2A" Foreground="White" FontWeight="Bold" Click="SendButton_Click">Send</Button>
                <TextBlock></TextBlock>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Height="90" Margin="0 5 0 0">
                <StackPanel DockPanel.Dock="Right" Margin="5 0 0 0">
                    <Button Padding="10 3" Margin="0 0 0 3" Click="AddFileButton_Click">Add file</Button>
                    <Button Padding="10 3" Click="RemoveFileButton_Click">Remove</Button>
                </StackPanel>
                <ListBox x:Name="filesListBox"></ListBox>
            </DockPanel>
            <Label DockPanel.Dock="Bottom">Attachments :</Label>
            <TextBox x:Name="bodyTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"></TextBox>
        </DockPanel>
    </Grid>
</Window>
