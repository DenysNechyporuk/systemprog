<Window x:Class="DownloadManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DownloadManager"
        mc:Ignorable="d"
        Title="Download Manager" Height="600" Width="1000" Background="#FFF4F6F8">
    <DockPanel Margin="10">
        <GroupBox DockPanel.Dock="Top" Header="New download" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0">URL :</Label>
                <TextBox x:Name="urlTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0 2" VerticalContentAlignment="Center"></TextBox>

                <Label Grid.Row="1">Save folder :</Label>
                <TextBox x:Name="folderTextBox" Grid.Row="1" Grid.Column="1" Margin="0 2" VerticalContentAlignment="Center"></TextBox>
                <Button Grid.Row="1" Grid.Column="2" Padding="10 0" Margin="5 2 0 2" Click="BrowseFolderButton_Click">...</Button>

                <Label Grid.Row="2">Tags :</Label>
                <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0 2">
                    <Button DockPanel.Dock="Right" Padding="20 3" Background="#FF00AB2A" Foreground="White" FontWeight="Bold" Click="DownloadButton_Click">Download</Button>
                    <ComboBox x:Name="threadsComboBox" DockPanel.Dock="Right" Width="50" Margin="5 0" SelectedIndex="0">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                    </ComboBox>
                    <Label DockPanel.Dock="Right">Threads :</Label>
                    <TextBox x:Name="tagsTextBox" VerticalContentAlignment="Center" ToolTip="Tags separated by comma (not required)"></TextBox>
                </DockPanel>
            </Grid>
        </GroupBox>

        <DockPanel DockPanel.Dock="Top" Margin="0 10 0 5">
            <Label>Show :</Label>
            <ComboBox x:Name="filterComboBox" Width="120" SelectedIndex="0" SelectionChanged="FilterComboBox_SelectionChanged">
                <ComboBoxItem>All</ComboBoxItem>
                <ComboBoxItem>Active</ComboBoxItem>
                <ComboBoxItem>Completed</ComboBoxItem>
                <ComboBoxItem>Failed</ComboBoxItem>
            </ComboBox>
            <Label Margin="10 0 0 0">Search by tag :</Label>
            <TextBox x:Name="searchTextBox" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"></TextBox>
        </DockPanel>

        <WrapPanel DockPanel.Dock="Bottom" Margin="0 5 0 0">
            <Button Padding="15 5" Margin="0 0 5 5" Click="PauseButton_Click">Pause / Resume</Button>
            <Button Padding="15 5" Margin="0 0 5 5" Click="StopButton_Click">Stop</Button>
            <Button Padding="15 5" Margin="0 0 15 5" Background="#FFE41717" Foreground="White" Click="DeleteButton_Click">Delete</Button>
            <Button Padding="15 5" Margin="0 0 5 5" Click="OpenButton_Click">Open</Button>
            <Button Padding="15 5" Margin="0 0 15 5" Click="MoveButton_Click">Move</Button>
            <TextBox x:Name="newNameTextBox" Width="180" Margin="0 0 5 5" VerticalContentAlignment="Center"></TextBox>
            <Button Padding="15 5" Margin="0 0 5 5" Click="RenameButton_Click">Rename</Button>
        </WrapPanel>

        <ListView x:Name="downloadsListView" SelectionChanged="DownloadsListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File" Width="220" DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Status" Width="150" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="Threads" Width="60" DisplayMemberBinding="{Binding Threads}"/>
                    <GridViewColumn Header="Tags" Width="150" DisplayMemberBinding="{Binding Tags}"/>
                    <GridViewColumn Header="Path" Width="280" DisplayMemberBinding="{Binding FilePath}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
