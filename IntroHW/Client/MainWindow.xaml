<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Говорун" Height="450" Width="400">
    <DockPanel Margin="5">
        <DockPanel DockPanel.Dock="Top">
            <Label>IP:</Label>
            <TextBox x:Name="ipTxtBox" Width="130" VerticalContentAlignment="Center">127.0.0.1</TextBox>
            <Label>Port:</Label>
            <TextBox x:Name="portTxtBox" VerticalContentAlignment="Center">8080</TextBox>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0 5">
            <Button DockPanel.Dock="Right" Width="70" Background="YellowGreen" FontWeight="Bold" Click="SendButton_Click" IsDefault="True">Send</Button>
            <TextBox x:Name="msgTxtBox" VerticalContentAlignment="Center" Margin="0 0 5 0"></TextBox>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" FontWeight="Bold">Dialog:</TextBlock>
        <ListBox x:Name="dialogList" Background="LightBlue" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
