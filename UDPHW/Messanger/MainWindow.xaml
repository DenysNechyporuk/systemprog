<Window x:Class="Messanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Messanger"
        mc:Ignorable="d"
        Title="UDP Chat" Height="450" Width="800" Background="#FF2B2D42" Closed="Window_Closed">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#FF8D99AE">
            <Label FontSize="15" FontWeight="Bold" Margin="10" Foreground="White">Nickname :</Label>
            <Button x:Name="joinBtn" Margin="5" Padding="20 10" DockPanel.Dock="Right" Click="JoinButton_Click" Background="#FF00AB2A" Foreground="White" FontWeight="Bold">Join</Button>
            <TextBox x:Name="nickTextBox" VerticalContentAlignment="Center" Margin="5" FontSize="14"></TextBox>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Background="#FF8D99AE">
            <Label FontSize="15" FontWeight="Bold" Margin="10" Foreground="White">Message :</Label>
            <Button x:Name="leaveBtn" Margin="5" Padding="20 10" DockPanel.Dock="Right" Click="LeaveButton_Click" Background="#FFE41717" Foreground="White" FontWeight="Bold" IsEnabled="False">Exit</Button>
            <Button x:Name="sendBtn" Margin="5" Padding="20 10" DockPanel.Dock="Right" Click="SendButtonClick" Background="#FF1398ED" Foreground="White" FontWeight="Bold" IsEnabled="False" IsDefault="True">Send</Button>
            <TextBox x:Name="msgTextBox" VerticalContentAlignment="Center" Margin="5" FontSize="14"></TextBox>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" FontWeight="Bold" FontSize="25" Foreground="#FFEDF2F4" Margin="5">Chat</TextBlock>
        <ListBox ItemsSource="{Binding}" Margin="10" Background="#FFEDF2F4" FontSize="14" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time, StringFormat=HH:mm}" Foreground="Gray"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
