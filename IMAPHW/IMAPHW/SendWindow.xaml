<Window x:Class="IMAPHW.SendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IMAPHW"
        mc:Ignorable="d"
        Title="New message" Height="450" Width="550">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0 3">
            <Label Width="70">To :</Label>
            <TextBox x:Name="toTextBox" VerticalContentAlignment="Center"></TextBox>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0 3">
            <Label Width="70">Subject :</Label>
            <TextBox x:Name="subjectTextBox" VerticalContentAlignment="Center"></TextBox>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0 5 0 0">
            <Button x:Name="sendBtn" DockPanel.Dock="Right" Padding="20 8" Background="#FF00AB2A" Foreground="White" FontWeight="Bold" Click="SendButton_Click">Send</Button>
            <TextBlock></TextBlock>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Height="80" Margin="0 5 0 0">
            <StackPanel DockPanel.Dock="Right" Margin="5 0 0 0">
                <Button Padding="10 3" Margin="0 0 0 3" Click="AddFileButton_Click">Add file</Button>
                <Button Padding="10 3" Click="RemoveFileButton_Click">Remove</Button>
            </StackPanel>
            <ListBox x:Name="filesListBox"></ListBox>
        </DockPanel>
        <Label DockPanel.Dock="Bottom">Attachments :</Label>
        <TextBox x:Name="bodyTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"></TextBox>
    </DockPanel>
</Window>
